---
layout: default
---
{%- assign faq = site.data.faq -%}
<div id="main-content" class="practice-page">
  <header class="page-header">
    <h1>{{ faq.heading }}</h1>
  </header>
  <div class="faq-list">
    {%- for item in faq.questions -%}
      <details class="faq-item">
        <summary><h2>{{ item.question }}</h2></summary>
        <div class="faq-answer">{{ item.answer | markdownify }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>
