---
layout: default
---
{%- assign about = site.data.about -%}
<div id="main-content" class="practice-page">
  <header class="page-header">
    <h1>{{ about.heading }}</h1>
  </header>
  <div class="about-grid">
    <div class="about-statements">
      <section aria-labelledby="mission-heading">
        <h2 id="mission-heading">{{ about.mission_heading }}</h2>
        <p>{{ about.mission }}</p>
      </section>
      <section aria-labelledby="vision-heading">
        <h2 id="vision-heading">{{ about.vision_heading }}</h2>
        <p>{{ about.vision }}</p>
      </section>
      <section aria-labelledby="values-heading">
        <h2 id="values-heading">{{ about.values_heading }}</h2>
        <ul class="values-list">
          {%- for v in about.values -%}
            <li>{{ v }}</li>
          {%- endfor -%}
        </ul>
      </section>
    </div>
    <aside class="founder-card" aria-label="{{ about.founder_title }}">
      {%- if about.founder_photo != '' -%}
        <img class="founder-photo" src="{{ about.founder_photo | relative_url }}" alt="{{ about.founder_photo_alt }}">
      {%- else -%}
        <div class="founder-photo founder-photo-placeholder" aria-hidden="true"></div>
      {%- endif -%}
      <p class="founder-name">{{ about.founder_name_line }}</p>
      <p class="founder-title">{{ about.founder_title }}</p>
      <p class="founder-role">{{ about.founder_role_line }}</p>
    </aside>
  </div>
</div>
