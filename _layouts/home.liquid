---
layout: default
---
{%- comment -%}
  Homepage, "Paint Tray" world. All text comes from _data (approved copy).
  Colour belongs to the five life stages only; everything else is ultramarine and ink.
  Photos: set `image`/`image_alt` in _services/*.md and `hero_photos` in
  _data/home.yml; until then each well shows a labelled placeholder.
{%- endcomment -%}
{%- assign home = site.data.home -%}
{%- assign settings = site.data.settings -%}
{%- assign contact = site.data.contact -%}
{%- assign services = site.services | sort: 'order' -%}
{%- assign pigments = 'gamboge,rose,sap,ultra,sienna' | split: ',' -%}
{%- assign tel = settings.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | prepend: '+1' -%}
<div id="main-content" class="tray-page">
  {%- comment -%} 1. The promise, the tray of photos, the ruler of life stages {%- endcomment -%}
  <section class="tray-hero" aria-labelledby="hero-heading">
    <div class="tray-hero-text">
      <h1 id="hero-heading">{{ home.hero_heading }}</h1>
      <p class="tray-actions">
        <a class="cake cake-ultra cake-lg" href="{{ '/contact/' | relative_url }}">{{ home.cta_label }}</a>
        <a class="tray-phone" href="tel:{{ tel }}">{{ settings.phone }}</a>
      </p>
    </div>
    <div class="tray tray-photos">
      {%- for i in (0..2) -%}
        {%- assign photo = home.hero_photos[i] -%}
        {%- if photo and photo.src and photo.src != '' -%}
          <img class="well well-{{ forloop.index }}" src="{{ photo.src | relative_url }}" alt="{{ photo.alt | default: services[i].title }}">
        {%- else -%}
          <div class="well well-{{ forloop.index }} well-placeholder" role="img" aria-label="Photo placeholder: {{ services[i].title }}">
            <svg class="well-mark" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
              <rect x="2.5" y="4.5" width="19" height="15" rx="3" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="8.5" cy="9.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 17.5l5.5-5 4 3.5 3-2.5 4.5 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>
            </svg>
            <span class="well-label" aria-hidden="true"><span class="well-kind">Photo placeholder</span> {{ services[i].title }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <nav class="pan-ruler" aria-label="{{ home.audiences_heading }}">
      <ul>
        {%- for a in site.data.audiences -%}
          <li>
            <a class="pan pig-{{ pigments[forloop.index0] }}" href="#{{ a.name | slugify }}">{{ a.name }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  </section>

  {%- comment -%}
    2. Services. A service with a photo gets a photo well in the tray beside its text
    (alternating sides); a service without one is shown as text only, so empty
    placeholders don't fill the page. The hero tray is the one placeholder showcase.
  {%- endcomment -%}
  <section class="tray-section" aria-labelledby="services-heading">
    <h2 id="services-heading">{{ home.services_heading }}</h2>
    <div class="service-rows">
      {%- for s in services -%}
        {%- assign has_photo = false -%}
        {%- if s.image and s.image != '' -%}{%- assign has_photo = true -%}{%- endif -%}
        <article class="service-row{% unless has_photo %} service-row--text{% endunless %}" aria-labelledby="svc-{{ s.slug }}">
          {%- if has_photo -%}
            <div class="tray service-tray">
              <img class="well service-well" src="{{ s.image | relative_url }}" alt="{{ s.image_alt | default: s.title }}" loading="lazy">
            </div>
          {%- endif -%}
          <div class="service-text">
            <h3 id="svc-{{ s.slug }}">{{ s.title }}</h3>
            <p>{{ s.card_summary }}</p>
            <a class="text-link" href="{{ '/services/' | relative_url }}#{{ s.slug }}"
              >Learn More<span class="sr-only"> about {{ s.title }}</span></a
            >
          </div>
        </article>
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} 3. Who we work with: five identical pans {%- endcomment -%}
  <section class="tray-band" aria-labelledby="audiences-heading">
    <div class="tray-section">
      <h2 id="audiences-heading">{{ home.audiences_heading }}</h2>
      <ul class="pan-set">
        {%- for a in site.data.audiences -%}
          <li class="pan-card" id="{{ a.name | slugify }}">
            <h3 class="pan pan-head pig-{{ pigments[forloop.index0] }}">{{ a.name }}</h3>
            <ul class="pan-list">
              {%- for b in a.bullets -%}
                <li>{{ b }}</li>
              {%- endfor -%}
            </ul>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>

  {%- comment -%} 4. Access points: the four ways in, then the next step {%- endcomment -%}
  <section class="tray-section" aria-labelledby="access-heading">
    <h2 id="access-heading">{{ home.access_points_heading }}</h2>
    <ol class="ways-in">
      {%- for item in site.data.access_points -%}
        <li class="way">
          <span class="way-pan" aria-hidden="true">{{ forloop.index }}</span>
          <h3>{{ item.title }}</h3>
          <div class="way-body">
            <p>{{ item.body }}</p>
            {%- if item.link and item.link != '' -%}
              <p>
                <a href="{{ item.link }}">{{ item.link_label | default: item.link }}</a>
              </p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
    <p class="tray-actions band-actions">
      <a class="cake cake-ultra cake-lg" href="{{ '/contact/' | relative_url }}">{{ home.cta_label }}</a>
      <a class="tray-phone" href="tel:{{ tel }}">{{ settings.phone }}</a>
    </p>
  </section>

  {%- comment -%} 5. The close: the tray's lid {%- endcomment -%}
  <section class="tray-lid" aria-labelledby="close-heading">
    <div class="tray-lid-inner">
      <div>
        <h2 id="close-heading">{{ contact.heading }}</h2>
        <p class="lid-lines">
          <a class="lid-phone" href="tel:{{ tel }}">{{ settings.phone }}</a>
          <a class="lid-email" href="mailto:{{ settings.email }}">{{ settings.email }}</a>
        </p>
      </div>
      <a class="cake cake-gamboge cake-lg" href="{{ '/contact/' | relative_url }}">{{ home.cta_label }}</a>
    </div>
  </section>
</div>
