---
layout: default
---
{%- assign c = site.data.contact -%}
{%- assign settings = site.data.settings -%}
<div id="main-content" class="practice-page">
  <div class="page-header">
    <h1>{{ c.heading }}</h1>
  </div>
  <div class="contact-grid">
    <div class="contact-details">
      <p class="contact-line">
        <a href="mailto:{{ settings.email }}">{{ settings.email }}</a>
      </p>
      <p class="contact-line">
        <a href="tel:{{ settings.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | prepend: '+1' }}">{{ settings.phone }}</a>
      </p>
    </div>
    <div class="contact-form-wrap">
      {%- if settings.form_endpoint != '' or jekyll.environment != 'production' -%}
        <p class="form-note">{{ c.privacy_note }}</p>
        {%- if settings.form_endpoint == '' -%}
          <p class="dev-note">Preview only: the form isn't connected to a form service yet, so it won't appear on the live site.</p>
        {%- endif -%}
        <form class="contact-form" action="{{ settings.form_endpoint }}" method="POST">
          <fieldset>
            <legend>{{ c.name_group_label }}</legend>
            <div class="name-row">
              <div class="form-field">
                <label for="first-name">
                  {{- c.first_name_label }}
                  <span class="req">{{ c.required_label }}</span></label
                >
                <input id="first-name" name="first_name" type="text" autocomplete="given-name" required>
              </div>
              <div class="form-field">
                <label for="last-name">
                  {{- c.last_name_label }}
                  <span class="req">{{ c.required_label }}</span></label
                >
                <input id="last-name" name="last_name" type="text" autocomplete="family-name" required>
              </div>
            </div>
          </fieldset>
          <div class="form-field">
            <label for="email">
              {{- c.email_label }}
              <span class="req">{{ c.required_label }}</span></label
            >
            <input id="email" name="email" type="email" autocomplete="email" required>
          </div>
          <div class="form-field">
            <label for="message">
              {{- c.message_label }}
              <span class="req">{{ c.required_label }}</span></label
            >
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>
          <div class="hp-field" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input id="website" name="_gotcha" type="text" tabindex="-1" autocomplete="off">
          </div>
          <button
            class="btn btn-primary"
            type="submit"
            {% if settings.form_endpoint == '' %}
              disabled
            {% endif %}
          >
            {{ c.submit_label }}
          </button>
        </form>
        {%- comment -%}
          Sent state. The form posts in the background (Formspree's free plan has no
          redirect) and this replaces it on success. Without JavaScript, or if the
          background send fails, the form submits normally to Formspree instead.
        {%- endcomment -%}
        {%- assign tel = settings.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | prepend: '+1' -%}
        {%- capture tel_link -%}<a href="tel:{{ tel }}">{{ settings.phone }}</a>{%- endcapture -%}
        <div class="form-thanks" id="form-thanks" tabindex="-1" hidden>
          <h2>{{ c.thanks_heading }}</h2>
          <p>{{ c.thanks_message | replace: settings.phone, tel_link }}</p>
          <a class="btn btn-primary" href="{{ '/' | relative_url }}">{{ c.thanks_home_label }}</a>
        </div>
        <script>
          (function () {
            var form = document.querySelector('.contact-form');
            var thanks = document.getElementById('form-thanks');
            if (!form || !thanks || !window.fetch || !window.FormData || !form.action) return;
            var note = document.querySelector('.form-note');
            var button = form.querySelector('button[type="submit"]');
            form.addEventListener('submit', function (event) {
              event.preventDefault();
              button.disabled = true;
              button.setAttribute('aria-busy', 'true');
              fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
                .then(function (response) {
                  if (!response.ok) throw new Error('send failed');
                  form.hidden = true;
                  if (note) note.hidden = true;
                  thanks.hidden = false;
                  thanks.focus();
                })
                .catch(function () {
                  // fall back to a normal post; Formspree shows its own result page
                  form.submit();
                });
            });
          })();
        </script>
      {%- endif -%}
    </div>
  </div>
</div>
